{
  "manifest_version": 3,
  "name": "OmniFetch Companion",
  "version": "1.5.0",
  "description": "Deteksi playlist video film, subtitle, dan sinkronisasi cookie media sosial ke OmniFetch.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://*.idlixku.com/*",
    "https://*.majorplay.net/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniFetch Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.idlixku.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
