{
  "manifest_version": 3,
  "name": "OmniFetch Companion",
  "version": "2.0.1",
  "description": "Asisten pintar untuk mengunduh video dari Instagram, YouTube, TikTok, Twitter, dan ribuan situs lainnya.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "cookies",
    "contextMenus",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.idlixku.com/*",
    "https://*.majorplay.net/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniFetch Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.idlixku.com/*"
      ],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["injector.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
